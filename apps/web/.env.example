# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site URL — used for sitemap.xml, robots.txt, and canonical/OG metadata.
# Placeholder until the real production domain is confirmed.
# NEXT_PUBLIC_SITE_URL=https://jufoods.com

# Order notifications: POST JSON after each successful order insert (e.g. n8n).
ORDER_WEBHOOK_URL=https://your-n8n.example.com/webhook/jufoods-order
# Optional: POST timeout in ms (default 8000, min 2000, max 30000)
# ORDER_WEBHOOK_TIMEOUT_MS=8000
# Optional: shared secret used to HMAC-sign the webhook payload (X-Jufoods-Signature).
# Configure the same value on the receiving n8n workflow to verify authenticity.
# ORDER_WEBHOOK_SECRET=

# Contact form notifications: POST JSON for each /contact submission (e.g. n8n).
# Required — without it, /api/contact returns 503 and the form shows an error
# instead of silently pretending the message was sent.
CONTACT_WEBHOOK_URL=https://your-n8n.example.com/webhook/jufoods-contact
# Optional: POST timeout in ms (default 8000, min 2000, max 30000)
# CONTACT_WEBHOOK_TIMEOUT_MS=8000
# Optional: shared secret used to HMAC-sign the webhook payload (X-Jufoods-Signature).
# CONTACT_WEBHOOK_SECRET=
