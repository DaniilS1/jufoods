# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# SMTP for order emails (optional - orders still saved to DB without)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Use SMTP_SECURE=true for implicit TLS (e.g. port 465)
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@yourdomain.com
# Manager inbox for new-order notifications (falls back to SMTP_FROM if unset)
ORDER_EMAIL=orders@yourdomain.com
